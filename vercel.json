{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "UV_THREADPOOL_SIZE=16 VITE_BUILD_FOR_PREVIEW=1 VITE_PUBLIC_POSTHOG_KEY= VITE_PUBLIC_POSTHOG_HOST= vite build --mode core",
      "cleanUrls": true,
      "rewrites": [{ "source": "/(.*)", "destination": "/" }],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ]
    },
    "backend": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/swagger-ui(.*)", "destination": { "service": "backend" } },
    { "source": "/v1/api-docs(.*)", "destination": { "service": "backend" } },
    { "source": "/v3/api-docs(.*)", "destination": { "service": "backend" } },
    { "source": "/fonts/(.*)", "destination": { "service": "backend" } },
    { "source": "/robots.txt", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
